generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- ENUMS ----------

enum UserRole {
  CUSTOMER_B2C
  CUSTOMER_B2B
  VENDOR
  ADMIN
}

enum PricingType {
  FIXED
  PER_UNIT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentType {
  CARD
  BANK_TRANSFER
}

enum TransactionStatus {
  PENDING
  PAID
  AWAITING_PROOF
  FAILED
  REFUNDED
}

enum InvoiceType {
  PROFORMA
  INVOICE
}

enum RFQStatus {
  OPEN
  OFFER_RECEIVED
  ACCEPTED
  REJECTED
  CLOSED
}

enum RFQOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum PromotionPlan {
  TOP_SEARCH_7D
  TOP_SEARCH_30D
  FEATURED_HOME_7D
  FEATURED_HOME_30D
}

// ---------- CORE USER ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String
  avatarUrl     String?
  role          UserRole  @default(CUSTOMER_B2C)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  companyProfile CompanyProfile?
  vendorProfile  VendorProfile?
  subAccountOf   SubAccount?

  bookings      Booking[]      @relation("CustomerBookings")
  rfqsCreated   RFQ[]          @relation("CompanyRFQs")
  messagesSent  Message[]      @relation("MessageSender")
  accounts      Account[]
  sessions      Session[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- B2B COMPANY ----------

model CompanyProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  companyName   String
  cui           String    @unique
  regCom        String
  sediuSocial   String
  validatedAt   DateTime?
  createdAt     DateTime  @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subAccounts SubAccount[]
  rfqs        RFQ[]
  invoices    Invoice[]

  @@index([cui])
}

model SubAccount {
  id               String   @id @default(cuid())
  userId           String   @unique
  companyProfileId String
  createdAt        DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyProfile CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
}

// ---------- VENDOR ----------

model VendorProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  displayName    String
  bio            String?
  galleryUrls    String[]  @default([])
  verifiedBadge  Boolean   @default(false)
  ratingAvg      Float     @default(0)
  ratingCount    Int       @default(0)
  promotedUntil  DateTime?
  promotionPlan  PromotionPlan?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  services            Service[]
  availabilities      Availability[]
  rfqOffers           RFQOffer[]
  promotionPurchases  PromotionPurchase[]
  reviews             Review[]
  messagesReceived    Message[]            @relation("MessageVendorThread")

  @@index([promotedUntil])
}

model Review {
  id        String   @id @default(cuid())
  vendorId  String
  bookingId String   @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  vendor  VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  booking Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

// ---------- CATALOG ----------

model Category {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique
  icon String

  services Service[]
}

model Service {
  id            String      @id @default(cuid())
  vendorId      String
  categoryId    String
  title         String
  description   String
  pricingType   PricingType
  priceNetRON   Float
  vatRate       Float       @default(0.19)
  unit          String?
  durationMins  Int?
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  vendor     VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category   Category      @relation(fields: [categoryId], references: [id])
  bookings   Booking[]
  rfqs       RFQ[]

  @@index([categoryId])
  @@index([vendorId])
}

model Availability {
  id        String   @id @default(cuid())
  vendorId  String
  date      DateTime
  startTime String
  endTime   String
  isBooked  Boolean  @default(false)

  vendor  VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  booking Booking?

  @@unique([vendorId, date, startTime])
  @@index([vendorId, date])
}

// ---------- BOOKING ----------

model Booking {
  id             String        @id @default(cuid())
  serviceId      String
  customerId     String
  availabilityId String?       @unique
  slotStart      DateTime
  slotEnd        DateTime
  status         BookingStatus @default(PENDING)
  totalPriceRON  Float
  paymentType    PaymentType
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  service      Service       @relation(fields: [serviceId], references: [id])
  customer     User          @relation("CustomerBookings", fields: [customerId], references: [id])
  availability Availability? @relation(fields: [availabilityId], references: [id])
  transaction  Transaction?
  review       Review?

  @@index([customerId])
  @@index([serviceId])
}

// ---------- RFQ (B2B NEGOTIATION) ----------

model RFQ {
  id               String    @id @default(cuid())
  companyId        String
  companyProfileId String
  serviceId        String?
  title            String
  description      String
  budgetMinRON     Float?
  budgetMaxRON     Float?
  status           RFQStatus @default(OPEN)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company        User           @relation("CompanyRFQs", fields: [companyId], references: [id])
  companyProfile CompanyProfile @relation(fields: [companyProfileId], references: [id])
  service        Service?       @relation(fields: [serviceId], references: [id])
  offers         RFQOffer[]
  messages       Message[]

  @@index([companyId])
  @@index([status])
}

model RFQOffer {
  id        String         @id @default(cuid())
  rfqId     String
  vendorId  String
  priceRON  Float
  message   String
  status    RFQOfferStatus @default(PENDING)
  createdAt DateTime       @default(now())

  rfq    RFQ           @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor VendorProfile @relation(fields: [vendorId], references: [id])

  @@index([rfqId])
  @@index([vendorId])
}

// ---------- MESSAGING ----------

model Message {
  id        String   @id @default(cuid())
  rfqId     String?
  vendorId  String?
  senderId  String
  body      String
  createdAt DateTime @default(now())

  rfq    RFQ?           @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor VendorProfile? @relation("MessageVendorThread", fields: [vendorId], references: [id])
  sender User           @relation("MessageSender", fields: [senderId], references: [id])

  @@index([rfqId])
  @@index([vendorId])
}

// ---------- PAYMENTS & INVOICING ----------

model Transaction {
  id             String            @id @default(cuid())
  bookingId      String?           @unique
  rfqOfferId     String?           @unique
  amountRON      Float
  method         PaymentType
  status         TransactionStatus @default(PENDING)
  stripePaymentId String?
  bankProofUrl   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  booking  Booking? @relation(fields: [bookingId], references: [id])
  invoice  Invoice?

  @@index([status])
}

model Invoice {
  id               String      @id @default(cuid())
  transactionId    String      @unique
  companyProfileId String?
  type             InvoiceType
  series           String
  number           Int
  buyerName        String
  buyerCui         String?
  buyerAddress     String
  totalNetRON      Float
  totalVatRON      Float
  totalGrossRON    Float
  pdfUrl           String?
  issuedAt         DateTime    @default(now())

  transaction    Transaction     @relation(fields: [transactionId], references: [id])
  companyProfile CompanyProfile? @relation(fields: [companyProfileId], references: [id])

  @@unique([series, number])
}

// ---------- MONETIZATION ----------

model PromotionPurchase {
  id          String        @id @default(cuid())
  vendorId    String
  plan        PromotionPlan
  amountPaidRON Float
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime      @default(now())

  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}
