# --- Bază de date ---
# Local:    postgresql://user:password@localhost:5432/zervio
# Supabase: Project Settings -> Database -> Connection string
#   DATABASE_URL = Connection pooling (port 6543, ?pgbouncer=true)
#   DIRECT_URL   = Direct connection (port 5432) — necesar pentru migrări Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/zervio"
DIRECT_URL="postgresql://user:password@localhost:5432/zervio"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
